{
  "ignoreCommand": "if [ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA^{commit}\" 2>/dev/null && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ':(exclude)*.md'; then exit 0; else exit 1; fi",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/weekly-coverage",
      "schedule": "0 16 * * 5"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 16 * * 0"
    },
    {
      "path": "/api/cron/weekly-url-review",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/apply-url-reviews",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/extraction-sweep",
      "schedule": "0 9 * * *"
    }
  ]
}

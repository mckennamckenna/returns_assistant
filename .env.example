# See BUILD.md "Env vars" for the authoritative list and descriptions —
# kept in sync with that table. Copy to .env.local and fill in real values.

AUTH_SECRET=
DATABASE_URL=
ANTHROPIC_API_KEY=
POSTMARK_SERVER_TOKEN=
POSTMARK_INBOUND_HASH=
INBOUND_DOMAIN=
REMINDER_FROM_EMAIL=
LOGIN_FROM_EMAIL=
CRON_SECRET=
ADMIN_EMAIL=
ADMIN_USER_EMAIL=
ADMIN_SECRET=
ALPHA_MODE=
ENCRYPTION_KEY=
TOKEN_SIGNING_SECRET=

# --- Alpha weekly search-and-verify (returnPortalUrl + retailer name) ---
# See BUILD.md "Alpha weekly search-and-verify" for the full flow.

# Root domain of the production app (no scheme, no path) — used ONLY by
# app/api/cron/weekly-url-review and app/api/cron/apply-url-reviews to
# score/reject search candidates that point back at our own app (a
# self-domain loop). MUST match the production reminder-sending domain.
# Deliberately a separate var from any domain check in
# lib/selfOutboundGuard.ts — that guard is an independently-owned concern;
# coupling the two means a rename to one silently breaks the other. Both
# cron routes fail loudly (500, before any Serper/Sheets call) if unset —
# there is no hardcoded default.
APP_DOMAIN=

# Google Cloud service-account credentials JSON (the whole blob, one line)
# — see BUILD.md for setup steps. Used by lib/sheets.ts to read/write the
# review Google Sheet.
GOOGLE_SERVICE_ACCOUNT_JSON=

# The review Google Sheet's spreadsheet ID (the long ID in its URL).
RETURN_URL_REVIEW_SHEET_ID=

# Serper.dev API key — used by lib/search.ts for the weekly candidate-URL
# search.
SERPER_API_KEY=
